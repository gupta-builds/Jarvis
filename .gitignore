# Jarvis memory registry (generated, regenerable)
30_Order/System/jarvis-memory/*.sqlite
30_Order/System/jarvis-memory/*.sqlite-wal
30_Order/System/jarvis-memory/*.sqlite-shm

# Python caches
__pycache__/
*.pyc

