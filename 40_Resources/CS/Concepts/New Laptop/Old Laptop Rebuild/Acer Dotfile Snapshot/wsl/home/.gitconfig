[core]
	autocrlf = false
	pager = delta
	fsmonitor = true
	untrackedCache = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
