y", "index": 3, "bbox": [0.293, 0.191, 0.334, 0.219], "content": ""}]}, {"type": "image", "index": 4, "bbox": [0.372, 0.191, 0.504, 0.224], "content": [{"type": "image_body", "index": 4, "bbox": [0.372, 0.191, 0.504, 0.224], "content": ""}]}, {"type": "image", "index": 5, "bbox": [0.135, 0.245, 0.26, 0.274], "content": [{"type": "image_body", "index": 5, "bbox": [0.135, 0.245, 0.26, 0.274], "content": ""}]}, {"type": "image", "index": 6, "bbox": [0.376, 0.246, 0.456, 0.274], "content": [{"type": "image_body", "index": 6, "bbox": [0.376, 0.246, 0.456, 0.274], "content": ""}]}, {"type": "image", "index": 7, "bbox": [0.185, 0.28, 0.299, 0.323], "content": [{"type": "image_body", "index": 7, "bbox": [0.185, 0.28, 0.299, 0.323], "content": ""}]}, {"type": "text", "index": 8, "bbox": [0.142, 0.337, 0.346, 0.364], "content": [{"type": "text", "content": "citations.bib"}]}, {"type": "text", "index": 9, "bbox": [0.144, 0.385, 0.297, 0.41], "content": [{"type": "text", "content": "main.tex"}]}, {"type": "text", "index": 10, "bbox": [0.14, 0.449, 0.496, 0.484], "content": [{"type": "text", "content": "Drop or paste your files, folder, or images here. Select files or select a folder from your computer."}]}]}, {"page_idx": 3, "blocks": [{"type": "image", "index": 0, "bbox": [0.141, 0.26, 0.304, 0.305], "content": [{"type": "image_body", "index": 0, "bbox": [0.141, 0.26, 0.304, 0.305], "content": ""}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.113, 0.092, 0.687, 0.12], "content": [{"type": "text", "content": "3. Rename the .bib file to “citations.bib”"}], "level": 2}, {"type": "text", "index": 2, "bbox": [0.114, 0.131, 0.519, 0.15], "content": [{"type": "text", "content": "Make sure that your .bib file has the correct name."}]}, {"type": "image", "index": 3, "bbox": [0.136, 0.169, 0.249, 0.203], "content": [{"type": "image_body", "index": 3, "bbox": [0.136, 0.169, 0.249, 0.203], "content": ""}]}, {"type": "image", "index": 4, "bbox": [0.294, 0.173, 0.334, 0.2], "content": [{"type": "image_body", "index": 4, "bbox": [0.294, 0.173, 0.334, 0.2], "content": ""}]}, {"type": "image", "index": 5, "bbox": [0.376, 0.174, 0.501, 0.204], "content": [{"type": "image_body", "index": 5, "bbox": [0.376, 0.174, 0.501, 0.204], "content": ""}]}, {"type": "image", "index": 6, "bbox": [0.135, 0.227, 0.26, 0.255], "content": [{"type": "image_body", "index": 6, "bbox": [0.135, 0.227, 0.26, 0.255], "content": ""}]}, {"type": "image", "index": 7, "bbox": [0.377, 0.227, 0.456, 0.255], "content": [{"type": "image_body", "index": 7, "bbox": [0.377, 0.227, 0.456, 0.255], "content": ""}]}, {"type": "text", "index": 8, "bbox": [0.142, 0.32, 0.346, 0.345], "content": [{"type": "text", "content": "citations.bib"}]}, {"type": "text", "index": 9, "bbox": [0.145, 0.367, 0.297, 0.391], "content": [{"type": "text", "content": "main.tex"}]}]}, {"page_idx": 4, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.113, 0.093, 0.419, 0.12], "content": [{"type": "text", "content": "4. Cite Your Sources"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.112, 0.148, 0.499, 0.171], "content": [{"type": "text", "content": "4.1 Create a References Section"}], "level": 2}, {"type": "text", "index": 2, "bbox": [0.112, 0.181, 0.876, 0.22], "content": [{"type": "text", "content": "To create a references section at the bottom of your document, add these lines to the bottom of your main LaTeX file, just before the \\end{document} line:"}]}, {"type": "code", "index": 3, "bbox": [0.13, 0.245, 0.79, 0.323], "content": [{"type": "code_body", "index": 3, "bbox": [0.13, 0.245, 0.79, 0.323], "content": "None\n\\bibliographystyle{plainurl} % Specify the bibliography style here\n\\bibliography{citations} % The .bib file without the extension\n\\end{document} % the last line of the LaTeX file - it should already exist"}], "sub_type": "code", "guess_lang": "latex"}, {"type": "text", "index": 4, "bbox": [0.112, 0.334, 0.839, 0.373], "content": [{"type": "text", "content": "You shouldn’t see any change in your file until you’ve actually cited something. We use the plainurl style because it’s simple and includes the URLs for online sources."}]}, {"type": "paragraph_title", "index": 5, "bbox": [0.114, 0.413, 0.239, 0.433], "content": [{"type": "text", "content": "URL Issues"}], "level": 2}, {"type": "text", "index": 6, "bbox": [0.112, 0.44, 0.866, 0.497], "content": [{"type": "text", "content": "If you notice that the URL looks weird in your references, it probably contains an underscore which LaTeX natively interprets as a subscript command. There are two potential ways to deal with this (you only need to pick one solution):"}]}, {"type": "paragraph_title", "index": 7, "bbox": [0.113, 0.533, 0.256, 0.552], "content": [{"type": "text", "content": "4.1.1 Use xurl"}], "level": 2}, {"type": "text", "index": 8, "bbox": [0.113, 0.561, 0.863, 0.602], "content": [{"type": "text", "content": "The xurl package makes URLs render properly. If you include the following line just after the \\documentclass{article} command, it should fix all your URL issues automatically"}]}, {"type": "code", "index": 9, "bbox": [0.131, 0.626, 0.805, 0.674], "content": [{"type": "code_body", "index": 9, "bbox": [0.131, 0.626, 0.805, 0.674], "content": "None\n\\usepackage{xurl} % put this near top (~2nd line) of .tex file"}], "sub_type": "code", "guess_lang": "txt"}, {"type": "paragraph_title", "index": 10, "bbox": [0.114, 0.721, 0.266, 0.74], "content": [{"type": "text", "content": "4.1.2 Manual Fix"}], "level": 2}, {"type": "text", "index": 11, "bbox": [0.112, 0.745, 0.838, 0.804], "content": [{"type": "text", "content": "Add a backslash before each underscore in each URL. This “escapes” the underscore and makes it so that LaTeX sees the underscore as the underscore symbol, rather than as a subscript command. (Just like how \\% is how the percent sign is escaped.)"}]}, {"type": "text", "index": 12, "bbox": [0.114, 0.822, 0.225, 0.84], "content": [{"type": "text", "content": "For example:"}]}]}, {"page_idx": 5, "blocks": [{"type": "code", "index": 0, "bbox": [0.114, 0.642, 0.475, 0.66], "content": [{"type": "code_body", "index": 0, "bbox": [0.114, 0.642, 0.475, 0.66], "content": "\\cite{source_name1, source_name2}"}], "sub_type": "code", "guess_lang": "latex"}, {"type": "code", "index": 1, "bbox": [0.126, 0.096, 0.84, 0.278], "content": [{"type": "code_body", "index": 1, "bbox": [0.126, 0.096, 0.84, 0.278], "content": "None\n@misc{reverse_turing_test,\n    title = {Reverse {Turing} {Test} {Experiment} with {AIs}},\n    url = {https://www.youtube.com/watch?v=MxTWLm9vT\\_o},\n    abstract = {Enjoy the videos and music you love, upload original content,\nand share it all with friends, family, and the world on YouTube.},\n    urldate = {2026-09-25},\n    journal = {YouTube},\n    author = {, Tamulur},\n}"}], "sub_type": "code", "guess_lang": "bib"}, {"type": "text", "index": 2, "bbox": [0.112, 0.289, 0.868, 0.345], "content": [{"type": "text", "content": "Notice that the URL uses a backslash before the underscore in the URL. You may have to edit the .bib file directly in order to make sure each underscore in each URL is prefaced with a backslash, as "}, {"type": "hyperlink", "url": "http://zbib.org", "content": [{"type": "text", "content": "zbib.org"}]}, {"type": "text", "content": " does not do this by default."}]}, {"type": "paragraph_title", "index": 3, "bbox": [0.113, 0.386, 0.211, 0.409], "content": [{"type": "text", "content": "4.2 Cite"}], "level": 2}, {"type": "text", "index": 4, "bbox": [0.112, 0.421, 0.876, 0.458], "content": [{"type": "text", "content": "To do inline citing, use the \\cite{source_name} command to cite a source where you use it. This usually looks something like:"}]}, {"type": "text", "index": 5, "bbox": [0.113, 0.46, 0.842, 0.5], "content": [{"type": "text", "content": "As seen in the video \\cite{video_name_in_bib_file}, the AIs quickly determined who the human was."}]}, {"type": "text", "index": 6, "bbox": [0.113, 0.52, 0.832, 0.56], "content": [{"type": "text", "content": "As seen in the video, the AIs quickly determined who the human was \\cite{video_name_in_bib_file}."}]}, {"type": "text", "index": 7, "bbox": [0.112, 0.583, 0.683, 0.601], "content": [{"type": "text", "content": "Note that citations should occur "}, {"type": "text", "content": "before", "styles": ["bold"]}, {"type": "text", "content": " the period ending the sentence."}]}, {"type": "text", "index": 8, "bbox": [0.113, 0.622, 0.676, 0.64], "content": [{"type": "text", "content": "If you’re citing two sources, then you can put a comma between them:"}]}, {"type": "text", "index": 9, "bbox": [0.112, 0.68, 0.86, 0.716], "content": [{"type": "text", "content": "You can find the source’s name by looking at your .bib file and seeing what the first line of the entry is."}]}, {"type": "text", "index": 10, "bbox": [0.112, 0.718, 0.826, 0.738], "content": [{"type": "text", "content": "For example, the following entry in BibTeX would be cited as \\cite{diaz_age_2020}:"}]}]}, {"page_idx": 6, "blocks": [{"type": "code", "index": 0, "bbox": [0.115, 0.09, 0.471, 0.295], "content": [{"type": "code_body", "index": 0, "bbox": [0.115, 0.09, 0.471, 0.295], "content": "@misc{diaz_age_2020,\n    title = {Age {Bias} {Training} and\n    {Testing} {Data}},\n    copyright = {CCO},\n    url =\n    {https://dataverse.harvard.edu/dataset.\n    xhtml?\n    persistentId=doi:10.7910/DVN/F6EMTS},\n    doi = {10.7910/DVN/F6EMTS},\n    abstract = {Training and testing\n    data annotated by a panel survey\n    sample of older adults (aged 50+) and"}], "sub_type": "code", "guess_lang": "bib"}, {"type": "text", "index": 1, "bbox": [0.113, 0.315, 0.865, 0.334], "content": [{"type": "text", "content": "Note that all the sources you don’t directly cite in your text will not show up in your references.", "styles": ["bold"]}]}, {"type": "text", "index": 2, "bbox": [0.112, 0.351, 0.872, 0.391], "content": [{"type": "text", "content": "To remedy this, sources you want to show up in your references section but don’t want them to be attached to particular text can be cited with the command \\nocite{source_name}."}]}, {"type": "text", "index": 3, "bbox": [0.112, 0.409, 0.878, 0.488], "content": [{"type": "text", "content": "If you don’t want to use inline citations at all, or want all of your citations to show up in your references regardless of if they’re cited in the rest of your text, use the command \\nocite{*}, where the “*” (asterisk/star) symbol indicates that LaTeX should silently cite everything in your citations.bib file."}]}, {"type": "paragraph_title", "index": 4, "bbox": [0.113, 0.528, 0.429, 0.549], "content": [{"type": "text", "content": "Advanced Citation Techniques"}], "level": 2}, {"type": "text", "index": 5, "bbox": [0.112, 0.557, 0.872, 0.615], "content": [{"type": "text", "content": "Instead of just using the cite command, which often chooses the citep or citet command behind the scenes, there are actually 3 different different commands you can use to cite works, depending on how you want the citation to show up."}]}, {"type": "paragraph_title", "index": 6, "bbox": [0.144, 0.633, 0.245, 0.65], "content": [{"type": "text", "content": "● \\citet"}], "level": 2}, {"type": "text", "index": 7, "bbox": [0.201, 0.653, 0.792, 0.67], "content": [{"type": "text", "content": "○ Use this command to cite a work by name in the middle of a sentence"}]}, {"type": "text", "index": 8, "bbox": [0.203, 0.672, 0.314, 0.689], "content": [{"type": "text", "content": "○ Example:"}]}, {"type": "code", "index": 9, "bbox": [0.259, 0.69, 0.853, 0.73], "content": [{"type": "code_body", "index": 9, "bbox": [0.259, 0.69, 0.853, 0.73], "content": "As seen in the video \\citet{video_name_in_bib_file}, the AIs quickly determined who the human was."}], "sub_type": "code", "guess_lang": "txt"}, {"type": "paragraph_title", "index": 10, "bbox": [0.144, 0.734, 0.244, 0.75], "content": [{"type": "text", "content": "● \\citep"}], "level": 2}, {"type": "text", "index": 11, "bbox": [0.202, 0.754, 0.781, 0.792], "content": [{"type": "text", "content": "○ Use this command to do what \\cite often does, which is to insert a parenthetical expression with the citation for the paper."}]}, {"type": "paragraph_title", "index": 12, "bbox": [0.204, 0.793, 0.314, 0.81], "content": [{"type": "text", "content": "○ Example:"}], "level": 2}, {"type": "text", "index": 13, "bbox": [0.26, 0.812, 0.857, 0.851], "content": [{"type": "text", "content": "As seen in the video, the AIs quickly determined who the human was \\citep{video_name_in_bib_file}."}]}, {"type": "paragraph_title", "index": 14, "bbox": [0.144, 0.854, 0.298, 0.871], "content": [{"type": "text", "content": "\\citeauthor"}], "level": 2}, {"type": "text", "index": 15, "bbox": [0.201, 0.874, 0.775, 0.891], "content": [{"type": "text", "content": "○ Use this command to grab the name of the author out of the citation"}]}, {"type": "text", "index": 16, "bbox": [0.203, 0.893, 0.314, 0.91], "content": [{"type": "text", "content": "○ Example:"}]}]}, {"page_idx": 7, "blocks": [{"type": "text", "index": 0, "bbox": [0.259, 0.092, 0.859, 0.175], "content": [{"type": "text", "content": "As seen in the video by \\citeauthor{video_name_in_bib_file}, the AIs quickly determined who the human was \\citep{video_name_in_bib_file}."}]}]}], "is_full_document": true, "schema": "docvortex.middle", "schema_version": "2.0"}