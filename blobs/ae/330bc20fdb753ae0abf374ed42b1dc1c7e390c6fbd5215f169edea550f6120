n}"}]}, {"type": "text", "index": 15, "bbox": [0.276, 0.726, 0.716, 0.746], "content": [{"type": "text", "content": "Lanczos iteration: "}, {"type": "equation_inline", "content": "AQ_{n} = Q_{n + 1}\\tilde{T}_{n}"}, {"type": "text", "content": ", "}, {"type": "equation_inline", "content": "T_{n} = Q_{n}^{T}AQ_{n}"}]}]}, {"page_idx": 4, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.194, 0.205, 0.381, 0.234], "content": [{"type": "text", "content": "Contents"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.194, 0.279, 0.862, 0.297], "content": [{"type": "text", "content": "Preface ix"}], "level": 2}, {"type": "paragraph_title", "index": 2, "bbox": [0.194, 0.314, 0.862, 0.334], "content": [{"type": "text", "content": "Acknowledgments xi"}], "level": 2}, {"type": "paragraph_title", "index": 3, "bbox": [0.194, 0.362, 0.862, 0.38], "content": [{"type": "text", "content": "I Fundamentals 1"}], "level": 2}, {"type": "text", "index": 4, "bbox": [0.223, 0.382, 0.861, 0.398], "content": [{"type": "text", "content": "Lecture 1 Matrix-Vector Multiplication 3"}]}, {"type": "text", "index": 5, "bbox": [0.223, 0.399, 0.86, 0.415], "content": [{"type": "text", "content": "Lecture 2 Orthogonal Vectors and Matrices . . . . . . . . . . . 11"}]}, {"type": "text", "index": 6, "bbox": [0.223, 0.416, 0.861, 0.431], "content": [{"type": "text", "content": "Lecture 3 Norms 17"}]}, {"type": "text", "index": 7, "bbox": [0.223, 0.433, 0.861, 0.449], "content": [{"type": "text", "content": "Lecture 4 The Singular Value Decomposition ..... 25"}]}, {"type": "text", "index": 8, "bbox": [0.223, 0.45, 0.861, 0.465], "content": [{"type": "text", "content": "Lecture 5 More on the SVD 32"}]}, {"type": "paragraph_title", "index": 9, "bbox": [0.194, 0.496, 0.862, 0.515], "content": [{"type": "text", "content": "II QR Factorization and Least Squares 39"}], "level": 2}, {"type": "text", "index": 10, "bbox": [0.223, 0.516, 0.86, 0.532], "content": [{"type": "text", "content